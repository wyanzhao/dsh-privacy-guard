{
  "name": "@local/dsh-privacy-guard",
  "version": "1.4.0",
  "description": "Local deterministic prompt masking with a single asterisk, without blocking requests.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyanzhao/dsh-privacy-guard.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "redactor.js",
    "json-spans.js",
    "dictionary.js",
    "cordis.patch.yml",
    "private-terms.example.json",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "eslint.config.js",
    ".prettierrc.json",
    ".prettierignore",
    "scripts/check-package.mjs",
    "test/*.test.js",
    "test/fixtures/*.json"
  ],
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=*.js --test-coverage-exclude=test/** --test-coverage-exclude=eslint.config.js --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=80",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run lint && npm run format:check && npm run test:coverage && npm run check:package"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
